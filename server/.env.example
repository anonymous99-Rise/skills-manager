# skills-manager-server runtime config.
# Copy to `.env` (same directory) and fill in real values. `.env` is gitignored.

# ── Gitea OAuth (web login) ──
GITEA_URL=https://git.nxwysoft.com
GITEA_CLIENT_ID=
GITEA_CLIENT_SECRET=
# Public origin users browse; must match a redirect URI registered on the
# Gitea OAuth2 app.
SM_PUBLIC_URL=http://36.1.40.14:18080
# Optional: restrict login to these Gitea users (comma separated)
# SM_ALLOWED_USERS=zhangz
# Optional: fixed session signing secret (otherwise auto-generated to /data)
# SM_SESSION_SECRET=

# ── Git backup credential for git.nxwysoft.com ──
# Pattern: SM_GIT_CRED_<HOST with non-alphanumerics as _> = user:token
SM_GIT_CRED_GIT_NXWYSOFT_COM=
